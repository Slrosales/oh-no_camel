(* Goal: 
   - a, b, c, d are in r0, r1, r2, r3
   - e is loaded from the stack (at r11 + offset)
   - Logic: (a + b + c + d) - e
*)

let _test_five a b c d e =
  let sum1 = add a b in        (* 10 + 20 = 30 *)
  let sum2 = add sum1 c in     (* 30 + 30 = 60 *)
  let sum3 = add sum2 d in     (* 60 + 40 = 100 *)
  sub sum3 e                   (* 100 - 5 = 95 *)

let _ =
  let p1 = 10 in
  let p2 = 20 in
  let p3 = 30 in
  let p4 = 40 in
  let p5 = 5 in
  let result = call _test_five p1 p2 p3 p4 p5 in
  call _min_caml_print_int result