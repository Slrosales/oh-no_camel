let _sum_of_7_arguments a b c d e f g =
    let sum1 = add a b in
    let sum2 = add sum1 c in
    let sum3 = add sum2 d in
    let sum4 = add sum3 e in
    let sum5 = add sum4 f in
    add sum5 g

let _ =
    let aa = 1 in
    let bb = 2 in
    let cc = 3 in
    let dd = 4 in
    let ee = 5 in
    let ff = 6 in
    let gg = 7 in
    let sum = call _sum_of_7_arguments aa bb cc dd ee ff gg in
    call _min_caml_print_int sum