  let t1_size = 2 in
  let t1 = new t1_size in
  let char_a = 65 in
  let num_100 = 100 in
  let idx0 = 0 in
  let idx1 = 1 in

  let d1 = mem(t1 + idx0) <- char_a in
  let d2 = mem(t1 + idx1) <- num_100 in

  let t2_size = 2 in
  let t2 = new t2_size in
  let char_b = 66 in
  let num_200 = 200 in
  let d3 = mem(t2 + idx0) <- char_b in
  let d4 = mem(t2 + idx1) <- num_200 in

  let i0 = 0 in
  let i1 = 1 in
